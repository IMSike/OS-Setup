    {
      "id": "drivers",
      "prompt": "Pilotes",
      "mode": "multi",
      "options": [
        "windows-update-drivers",
        "dell-command-update",
        "lenovo-system-update",
        "hp-support-assistant",
        "intel-driver-assistant"
      ],
      "default": [
        "windows-update-drivers",
        "dell-command-update",
        "lenovo-system-update",
        "hp-support-assistant"
      ],
      "min": 0
    },
    {
      "id": "advanced",
      "prompt": "Options avancées",
      "mode": "multi",
      "options": [
        "crash-dumps-local"
      ],
      "default": [],
      "min": 0
    }
  ]
}
