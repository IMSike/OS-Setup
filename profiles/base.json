    {
      "id": "remove-xbox",
      "prompt": "Xbox à supprimer",
      "mode": "multi",
      "options": [
        "remove-xbox-app",
        "remove-game-bar",
        "remove-xbox-live"
      ],
      "default": [],
      "min": 0
    },
    {
      "id": "remove-components",
      "prompt": "Composants Windows à retirer",
      "mode": "multi",
      "options": [
        "remove-internet-explorer",
        "remove-powershell-v2",
        "remove-steps-recorder",
        "remove-wordpad",
        "remove-powershell-ise",
        "remove-math-input",
        "remove-hello-face",
        "remove-quick-assist",
        "remove-fax-scan",
        "remove-print-management",
        "remove-work-folders",
        "remove-smb-direct",
        "remove-xps-printer"
      ],
      "default": [
        "remove-internet-explorer",
        "remove-powershell-v2",
        "remove-steps-recorder",
        "remove-powershell-ise",
        "remove-quick-assist",
        "remove-print-management",
        "remove-work-folders",
        "remove-smb-direct",
        "remove-xps-printer",
        "remove-wordpad",
        "remove-hello-face"
      ],
      "min": 0
