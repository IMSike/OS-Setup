{
  "$schema": "../../schemas/item.schema.json",
  "id": "claude-statusline",
  "name": "Claude Code : barre d'état",
  "category": "dev",
  "platforms": ["windows"],
  "dependsOn": ["claude-code", "jq"],
  "actions": [
    {
      "provider": "file",
      "description": "script de la barre d'état (bash, lit le JSON de Claude Code avec jq)",
      "source": "claude/statusline-command.sh",
      "target": "{{UserProfile}}\\.claude\\statusline-command.sh",
      "mode": "copy"
    },
    {
      "provider": "file",
      "description": "description de la barre d'état : lignes, segments, icônes, couleurs",
      "source": "claude/statusline-config.json",
      "target": "{{UserProfile}}\\.claude\\statusline-config.json",
      "mode": "copy"
    },
    {
      "provider": "file",
      "description": "Claude Code : barre d'état activée",
      "source": "claude/statusline.json",
      "target": "{{UserProfile}}\\.claude\\settings.json",
      "mode": "merge-json"
    }
  ]
}
