{
  "$schema": "../../schemas/item.schema.json",
  "id": "cortana-off",
  "name": "Cortana : désactivée",
  "category": "privacy",
  "platforms": ["windows"],
  "requiresAdmin": true,
  "requiresLogoff": true,
  "actions": [
    {
