{
  "$schema": "../../schemas/item.schema.json",
  "id": "perm-notifications",
  "name": "Notifications : accès refusé",
  "category": "privacy",
  "platforms": ["windows"],
  "notes": "Ne concerne pas les applications de bureau classiques (navigateurs, Zoom…), réglées à part dans Paramètres.",
  "actions": [
    {
      "provider": "registry",
      "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\CapabilityAccessManager\\ConsentStore\\userNotificationListener",
      "name": "Value",
      "type": "String",
      "value": "Deny"
    }
  ]
}
